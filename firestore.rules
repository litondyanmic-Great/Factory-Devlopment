rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFactoryOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'liton.dynmic@gmail.com'
      );
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isFactoryOwner() ? 'admin' : (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? myProfile().role
          : 'none'
      );
    }

    function isActive() {
      return isFactoryOwner() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && myProfile().status == 'active'
      );
    }

    function isAdmin() {
      return isFactoryOwner() || (isActive() && myRole() == 'admin');
    }

    function hasRole(roles) {
      return isFactoryOwner() || (isActive() && (myRole() in roles || myRole() == 'admin'));
    }

    function mySections() {
      return ('sections' in myProfile()) ? myProfile().sections : [];
    }

    function canEnterSection(sectionKey) {
      return isFactoryOwner() || (
        isActive() && (
          myRole() == 'admin' ||
          mySections().size() == 0 ||
          sectionKey in mySections()
        )
      );
    }

    function hasAdminArea(area) {
      return isAdmin() || (
        isActive() && ('adminAreas' in myProfile()) && area in myProfile().adminAreas
      );
    }

    function isYarnApprover() {
      return isAdmin() || (
        isActive() && myProfile().canApproveYarnOverage == true
      );
    }

    function canDecideInspection() {
      return hasAdminArea('quality') || isYarnApprover();
    }

    // --- Collection-group queries -------------------------------------
    match /{path=**}/yarnLedger/{entryId} {
      allow read: if isActive();
    }
    match /{path=**}/accessoryLedger/{entryId} {
      allow read: if isActive();
    }
    match /{path=**}/productionEntries/{entryId} {
      allow read: if isActive();
      allow write: if isActive() && hasRole(['admin', 'production']);
    }
    match /{path=**}/shipments/{shipmentId} {
      allow read: if isActive();
    }
    match /{path=**}/yarnIssueApprovals/{reqId} {
      allow read: if isActive();
    }
    match /{path=**}/ieRecords/{recordId} {
      allow read: if isActive();
    }

    // system/meta — tracks factory initialization
    match /system/meta {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // settings/company — factory branding and configs
    match /settings/company {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // defectTypes/{section}
    match /defectTypes/{section} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'production', 'gpq']);
      allow delete: if isAdmin();
    }

    // users/{uid} — user accounts and access control
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'department', 'sections', 'adminAreas']))
      );
      allow delete: if isAdmin();
    }

    // styles/{styleId} — style catalogue & order tracking
    match /styles/{styleId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'merchandising', 'production']);
      allow delete: if isAdmin();

      // styles/{styleId}/productionEntries
      match /productionEntries/{entryId} {
        allow read: if isActive();
        allow create, update: if isActive() && hasRole(['admin', 'production']);
        allow delete: if isActive() && (isAdmin() || hasRole(['admin', 'production']));
      }

      // styles/{styleId}/yarnLedger
      match /yarnLedger/{entryId} {
        allow read: if isActive();
        allow create: if isActive() && (
          hasRole(['admin', 'store', 'production', 'merchandising']) ||
          canEnterSection('yarnStore') ||
          canEnterSection('winding') ||
          canEnterSection('knitting')
        );
        allow update: if isActive() && (
          isAdmin() ||
          hasAdminArea('inventory') ||
          hasAdminArea('quality') ||
          hasRole(['admin', 'store', 'gpq', 'production'])
        );
        allow delete: if isAdmin() || hasAdminArea('inventory');
      }

      // styles/{styleId}/accessoryLedger
      match /accessoryLedger/{entryId} {
        allow read: if isActive();
        allow create: if isActive() && (hasRole(['admin', 'store', 'production']) || canEnterSection('accessoriesStore'));
        allow update: if isActive() && (
          isAdmin() ||
          hasAdminArea('inventory') ||
          hasAdminArea('quality') ||
          hasRole(['admin', 'store', 'gpq', 'production'])
        );
        allow delete: if isAdmin() || hasAdminArea('inventory');
      }

      // styles/{styleId}/shipments
      match /shipments/{shipmentId} {
        allow read: if isActive();
        allow create, update: if isActive() && hasRole(['admin', 'gpq', 'merchandising']);
        allow delete: if isAdmin();
      }

      // styles/{styleId}/yarnIssueApprovals
      match /yarnIssueApprovals/{reqId} {
        allow read: if isActive();
        allow create: if isActive() && (hasRole(['admin', 'store']) || canEnterSection('yarnStore'));
        allow update: if isYarnApprover();
        allow delete: if isAdmin();
      }

      // styles/{styleId}/ieRecords
      match /ieRecords/{recordId} {
        allow read: if isActive();
        allow create, update: if isActive() && hasRole(['admin', 'ie']);
        allow delete: if hasAdminArea('production') || isAdmin();
      }
    }

    // ieTargets/{targetId} — IE production targets & SMV values
    match /ieTargets/{targetId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'ie', 'production']);
      allow delete: if isAdmin();
    }

    // inventoryItems/{itemId} — raw material inventory catalog
    match /inventoryItems/{itemId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'store', 'merchandising']);
      allow delete: if hasAdminArea('inventory') || isAdmin();

      match /transactions/{txnId} {
        allow read: if isActive();
        allow create, update, delete: if isActive() && (hasRole(['admin', 'store']) || hasAdminArea('inventory'));
      }
    }

    // qualityChecks/{checkId} — QC inspections
    match /qualityChecks/{checkId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'gpq', 'production']);
      allow delete: if hasAdminArea('quality') || isAdmin();
    }

    // zeroThreadReports/{reportId} — Loose thread QC inspection
    match /zeroThreadReports/{reportId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'gpq', 'production']);
      allow delete: if hasAdminArea('quality') || isAdmin();
    }

    // yarnLeftoverLedger/{entryId} — Central leftover yarn bank
    match /yarnLeftoverLedger/{entryId} {
      allow read: if isActive();
      allow create, update: if isActive() && (hasRole(['admin', 'store']) || canEnterSection('yarnStore'));
      allow delete: if hasAdminArea('inventory') || isAdmin();
    }

    // chalans/{chalanId} — Digital chalans and gate passes
    match /chalans/{chalanId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'store', 'merchandising', 'production']);
      allow delete: if isAdmin();
    }

    // packingLists/{listId} — Export packing lists & CBM calculations
    match /packingLists/{listId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'gpq', 'merchandising', 'production']);
      allow delete: if isAdmin();
    }

    // bundles/{bundleId} — QR bundles tracking
    match /bundles/{bundleId} {
      allow read: if isActive();
      allow create, update: if isActive() && hasRole(['admin', 'production', 'gpq']);
      allow delete: if isAdmin();
    }
  }
}
